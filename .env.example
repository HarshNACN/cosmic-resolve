# ==============================================================================
# COSMIC RESOLVE - ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# This file is a TEMPLATE only.
#
# Do not put AWS access keys, secret keys, session tokens, or other credentials
# in this file.
#
# Our workshop environment uses the AWS "bootcamp" profile and temporary
# credentials obtained through AWS login.
#
# If a local .env file is needed later:
#   1. Copy this file to .env
#   2. Keep .env local
#   3. Never commit .env to Git
#
# .env should already be excluded by .gitignore.
# ==============================================================================


# ------------------------------------------------------------------------------
# MODEL PROVIDER
# ------------------------------------------------------------------------------

# Cosmic Resolve will use Amazon Bedrock as its model provider.
MODEL_PROVIDER=bedrock


# ------------------------------------------------------------------------------
# AWS / AMAZON BEDROCK
# ------------------------------------------------------------------------------

# Workshop-provided AWS CLI profile.
AWS_PROFILE=bootcamp

# Workshop AWS region.
AWS_REGION=us-east-2

# Some boto3 credential providers (e.g. `aws login` profiles) read this name instead of AWS_REGION.
AWS_DEFAULT_REGION=us-east-2

# Tells Claude Code to use Amazon Bedrock rather than direct Anthropic access.
CLAUDE_CODE_USE_BEDROCK=1


# ------------------------------------------------------------------------------
# MODEL CONFIGURATION
# ------------------------------------------------------------------------------

# Pinned: Claude Sonnet 5.5 through its US inference profile (verified T04).
# The bare model ID is rejected by Bedrock, so the profile is required.
#
# The backend loads this file automatically when copied to .env:
#   copy .env.example .env

BEDROCK_MODEL_ID=
BEDROCK_INFERENCE_PROFILE=us.anthropic.claude-sonnet-5-5

# Optional: estimated cost in eval scorecards. Prices per million tokens, from the current Bedrock price list
# for your model; none are set in code. Set both or neither. Empty means no cost is reported (tokens still are).
COSMIC_COST_PER_MTOK_INPUT_USD=
COSMIC_COST_PER_MTOK_OUTPUT_USD=


# ------------------------------------------------------------------------------
# VOICE INTAKE (local demo only; setup and demo script in docs/VOICE.md)
# ------------------------------------------------------------------------------

# Speech to text: Groq Whisper (free tier). GROQ_API_KEY is a secret: set it only in your local .env.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# The model that runs the spoken conversation. Measured about 0.5 s to the first sentence; Sonnet 5.5 was slower
# and sometimes took several seconds, so it is not used here.
BEDROCK_DIALOGUE_PROFILE=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Text to speech: Piper. Path to a downloaded voice (.onnx); a relative path starts at the repository root.
PIPER_VOICE=voices/en_US-lessac-medium.onnx

# Let the approval checkpoint run the mock write actions (needed for the demo's Approve button).
# Uncomment for local use only. Never set this on a public deployment.
# CHECKPOINT_WRITES_ENABLED=true


# ------------------------------------------------------------------------------
# LIVE MODEL IN THE WEB APP (local demo only)
# ------------------------------------------------------------------------------

# Make the API's /propose call Bedrock instead of the offline rules. Requires an AWS login (see below).
# Never set this on a public deployment; vercel.json must not set it.
# COSMIC_RESOLVE_LIVE=true

# With COSMIC_RESOLVE_LIVE=true: "agent" lets the model choose its own read tools (investigation loop).
# Anything else keeps the fixed pipeline.
# COSMIC_RESOLVE_PIPELINE=agent


# ==============================================================================
# BUILDER SETUP - POWERSHELL
# ==============================================================================
#
# NOTE:
# The commands below are documentation comments. They are NOT executed when
# this .env.example file is loaded.
#
# 1. Authenticate to the workshop AWS account:
#
#    aws login --profile bootcamp --region us-east-2
#
#
# 2. Configure the current PowerShell session:
#
#    $env:AWS_PROFILE = "bootcamp"
#    $env:AWS_REGION = "us-east-2"
#    $env:CLAUDE_CODE_USE_BEDROCK = "1"
#
#
# 3. Verify AWS authentication:
#
#    aws sts get-caller-identity
#
#
# 4. Verify Anthropic models are visible through Amazon Bedrock:
#
#    aws bedrock list-foundation-models --region us-east-2 | Select-String "anthropic"
#
#
# 5. Start Claude Code from the repository root:
#
#    claude
#
#
# 6. Inside Claude Code, verify the active provider/configuration:
#
#    /status
#
#
# If the AWS session expires, authenticate again with:
#
#    aws login --profile bootcamp --region us-east-2
#
# ==============================================================================


# ==============================================================================
# SECURITY
# ==============================================================================
#
# DO NOT add credentials such as:
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# ANTHROPIC_API_KEY=
#
# Builders authenticate through the workshop-provided AWS profile instead.
#
# Never commit:
#   - .env
#   - AWS credentials
#   - access keys
#   - secret keys
#   - session tokens
#   - API keys
#
# ==============================================================================
# FUTURE CONFIGURATION
# ==============================================================================
#
# Add new variables only when Cosmic Resolve actually requires them.
#
# Possible future categories may include:
#   - backend runtime configuration
#   - frontend/backend API configuration
#   - logging / tracing configuration
#   - evaluation configuration
#
# Do not add speculative credentials, database URLs, external service keys,
# or infrastructure variables until those systems are actually introduced.
#
# ==============================================================================