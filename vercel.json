{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "api:app",
      "routes": [
        {
          "src": "/api/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/$1"
            }
          ]
        }
      ]
    },
    "landing": {
      "root": "landing",
      "framework": "vite"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "outputDirectory": "dist"
    },
    "customer": {
      "root": "customer-frontend",
      "framework": "vite",
      "outputDirectory": "dist"
    }
  },
  "redirects": [
    {
      "source": "/support",
      "destination": "/support/",
      "permanent": false
    },
    {
      "source": "/internal",
      "destination": "/internal/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/support(/.*)?",
      "destination": {
        "service": "customer"
      }
    },
    {
      "source": "/internal(/.*)?",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "landing"
      }
    }
  ]
}
